# Copie para .env (já está no .gitignore — nunca versionar o de verdade)
# antes de rodar qualquer abertura de cesta contra um MT5 real.
#
# Variável do sistema (ex.: Task Scheduler do Windows) sempre tem
# prioridade sobre o .env — o arquivo é só uma forma conveniente de
# configurar localmente, nunca a fonte de verdade.

# Login da conta MT5 que o sistema tem permissão de operar. Sem isso
# configurado, TODA abertura de cesta é recusada — mesmo em conta demo.
# Necessário porque essa máquina roda vários terminais MT5 simultâneos
# (estratégias diferentes, contas diferentes); "a conta é demo" sozinho
# não garante que é a conta certa.
CSS_MT5_EXPECTED_LOGIN=

# Só true/1 libera abrir cesta numa conta que NÃO seja demo — e mesmo
# assim só funciona se o login também bater com CSS_MT5_EXPECTED_LOGIN.
# Deixe vazio/false até decidir deliberadamente sair de demo.
CSS_LIVE_TRADING=false

# Caminho do terminal64.exe da instância MT5 que o sistema conecta. Pensado
# pra uma instância /portable dedicada (sem FILE_COMMON — Python grava/lê
# direto na MQL5/Files desta mesma pasta, já que não é compartilhada com
# outras estratégias/contas na máquina).
CSS_MT5_TERMINAL_PATH=

# Sufixo de símbolo da corretora. Varia por corretora E por tipo de conta —
# na Exness usada aqui, os pares são "EURUSDm", "GBPUSDm" etc., e nenhum
# existe com o nome puro. Sem o sufixo certo, toda ordem falha com
# "símbolo não encontrado" (a abertura recusa a cesta inteira, não parcial).
# Descubra com: mt5.symbols_get("*EURUSD*") na conta.
CSS_MT5_SYMBOL_SUFFIX=

# Stop-loss catastrófico em pips — rede de segurança pro cenário "Python
# morto e terminal morto ao mesmo tempo", não parâmetro de estratégia.
# Recalibrar com a pior excursão histórica real por perna antes de
# qualquer conta real (ver comentário em agents/portfolio_executor.py).
# Ausente usa este mesmo default (150) e abre normalmente; um valor
# EXPLICITAMENTE fornecido e inválido (não-numérico, <= 0, não-finito)
# recusa a abertura em vez de cair em silêncio no default — ver
# check_execution_config() em agents/portfolio_executor.py.
CSS_CATASTROPHIC_SL_PIPS=150

# Tetos de exposição e parâmetros de confirmação de ordem ambígua — nenhum
# altera a estratégia no valor padrão, existem pra impedir que um erro de
# chamada, payload malformado, ou mudança acidental vire uma posição maior
# que a pretendida. Mesma regra do CSS_CATASTROPHIC_SL_PIPS acima: ausente
# usa o default e abre normalmente, só um valor explícito e inválido recusa
# (check_execution_config() em agents/portfolio_executor.py).
CSS_MAX_LOT=0.01
CSS_MAX_CONCURRENT_BASKETS=8
CSS_AMBIGUOUS_CONFIRM_ATTEMPTS=3
CSS_AMBIGUOUS_CONFIRM_DELAY_SEC=1.0

# Chave exigida pelos endpoints /api/portfolio-robots/open e /close em
# web/server.py. Sem isso definido, os endpoints recusam qualquer chamada
# (fail-closed).
CSS_PORTFOLIO_API_KEY=
