# Copie para .env (já está no .gitignore — nunca versionar o de verdade)
# antes de rodar qualquer abertura de cesta contra um MT5 real.
#
# Variável do sistema (ex.: Task Scheduler do Windows) sempre tem
# prioridade sobre o .env — o arquivo é só uma forma conveniente de
# configurar localmente, nunca a fonte de verdade.

# Login da conta MT5 que o sistema tem permissão de operar. Sem isso
# configurado, TODA abertura de cesta é recusada — mesmo em conta demo.
# Necessário porque essa máquina roda vários terminais MT5 simultâneos
# (estratégias diferentes, contas diferentes); "a conta é demo" sozinho
# não garante que é a conta certa.
CSS_MT5_EXPECTED_LOGIN=

# Só true/1 libera abrir cesta numa conta que NÃO seja demo — e mesmo
# assim só funciona se o login também bater com CSS_MT5_EXPECTED_LOGIN.
# Deixe vazio/false até decidir deliberadamente sair de demo.
CSS_LIVE_TRADING=false

# Caminho do terminal64.exe da instância MT5 que o sistema conecta. Pensado
# pra uma instância /portable dedicada (sem FILE_COMMON — Python grava/lê
# direto na MQL5/Files desta mesma pasta, já que não é compartilhada com
# outras estratégias/contas na máquina).
CSS_MT5_TERMINAL_PATH=

# Sufixo de símbolo da corretora. Varia por corretora E por tipo de conta —
# na Exness usada aqui, os pares são "EURUSDm", "GBPUSDm" etc., e nenhum
# existe com o nome puro. Sem o sufixo certo, toda ordem falha com
# "símbolo não encontrado" (a abertura recusa a cesta inteira, não parcial).
# Descubra com: mt5.symbols_get("*EURUSD*") na conta.
CSS_MT5_SYMBOL_SUFFIX=

# Stop-loss catastrófico em pips — rede de segurança pro cenário "Python
# morto e terminal morto ao mesmo tempo", não parâmetro de estratégia.
# Recalibrar com a pior excursão histórica real por perna antes de
# qualquer conta real (ver comentário em agents/portfolio_executor.py).
# Ausente usa este mesmo default (150) e abre normalmente; um valor
# EXPLICITAMENTE fornecido e inválido (não-numérico, <= 0, não-finito)
# recusa a abertura em vez de cair em silêncio no default — ver
# check_execution_config() em agents/portfolio_executor.py.
CSS_CATASTROPHIC_SL_PIPS=150

# Tetos de exposição e parâmetros de confirmação de ordem ambígua — nenhum
# altera a estratégia no valor padrão, existem pra impedir que um erro de
# chamada, payload malformado, ou mudança acidental vire uma posição maior
# que a pretendida. Mesma regra do CSS_CATASTROPHIC_SL_PIPS acima: ausente
# usa o default e abre normalmente, só um valor explícito e inválido recusa
# (check_execution_config() em agents/portfolio_executor.py).
CSS_MAX_LOT=0.01
CSS_MAX_CONCURRENT_BASKETS=8
CSS_AMBIGUOUS_CONFIRM_ATTEMPTS=3
CSS_AMBIGUOUS_CONFIRM_DELAY_SEC=1.0

# Margem livre mínima (na moeda da própria conta) pra liberar uma ABERTURA —
# item 2 do plano de reconciliação com o upstream (Miquéias): lá existe uma
# checagem parecida, mas fail-open (account_info() None ou exceção pulam a
# checagem inteira) e com a moeda hardcoded na mensagem. Aqui, igual às
# variáveis acima, ausente usa este default (50) e abre normalmente; um
# valor explícito e inválido recusa a abertura. Mas margin_free em si
# (lido AO VIVO da conta em check_account_gate(), não este limiar) ausente
# ou não-finito TAMBÉM recusa — fail-closed, nunca vira "margem infinita".
#
# ATENÇÃO (achado P2-1, mfc-rev-2, herdr-review rodada 15, confirmado por
# mfc-rev/F15-01): diferente das outras cinco variáveis desta seção, este
# NÃO é um "default seguro" sozinho — é só um piso fixo, absoluto,
# independente de corretora/alavancagem/moeda/símbolo. Numa conta 1:100
# (alavancagem retail comum), a margem de uma cesta de 0.01 lote gira em
# torno de $70 — acima deste default de $50. Passar neste piso não
# significa "a cesta cabe", só "não está numa situação de margem
# catastroficamente baixa" — é por isso que existe TAMBÉM o cálculo
# agregado via order_calc_margin() somado nas 7 pernas, dentro do preflight
# de open_portfolio_basket() (decisão do Breno 27/08, via herdr-ask consulta
# 3 + árbitro efêmero — conta real prevista pra semanas, implementar já em
# vez de esperar o lote de recalibração do CSS_CATASTROPHIC_SL_PIPS). Este
# valor agora funciona como a RESERVA que deve sobrar depois de cobrir a
# margem estimada das 7 pernas, não só o piso isolado de antes. Recalibrar
# pra cobrir a margem real da alavancagem/corretora em uso continua
# bloqueante ANTES de qualquer conta real, mesma ressalva do
# CSS_CATASTROPHIC_SL_PIPS — e order_calc_margin() em si é Windows-only,
# não roda no checkout Linux onde isto foi escrito: validar manualmente no
# terminal real (margem prevista vs. queda observada numa execução demo
# controlada) antes de ligar CSS_LIVE_TRADING=true.
CSS_MIN_MARGIN_FREE=50.0

# Orçamento de tempo (segundos) do watchdog de FECHAMENTO compulsório das
# 08:00 — quanto tempo, no total, close_all_portfolios() insiste reconsultando
# o broker antes de desistir e reportar falha. SÉTIMA variável tunável do
# sistema, mas DELIBERADAMENTE fora das seis acima: fechar nunca pode ser
# recusado por config ruim (reduzir risco nunca é bloqueado), então um valor
# ausente ou explicitamente inválido aqui cai no default (90s) e o fechamento
# segue normalmente — nunca recusa. Faixa [10, 120]s: o teto de 120 (não mais)
# existe pra que "deadline + a última rodada em andamento quando ele expira"
# não estoure a janela real de 240s do scheduler (08:00-08:04) mesmo com um
# broker lento — ver comentário em agents/portfolio_executor.py.
CSS_CLOSE_WATCHDOG_DEADLINE_SEC=90.0

# Offset GMT do servidor MT5, usado só pro track record/backtest (nunca pro
# caminho de execução ao vivo) rotular sessão/data e escolher a barra de
# entrada certa — ver web/history_tracker.py. Ausente usa -3 (BRT). Um valor
# fora de [-12, 14] (fuso real) só AVISA no import, não recusa nada — errar
# aqui contamina diagnóstico/backtest, não abre ordem errada.
CSS_MT5_GMT_OFFSET=-3

# Chave exigida pelos endpoints /api/portfolio-robots/open e /close em
# web/server.py. Sem isso definido, os endpoints recusam qualquer chamada
# (fail-closed).
CSS_PORTFOLIO_API_KEY=

# Login (usuário/senha únicos, compartilhados) exigido por
# POST /api/backtest-history/trigger e GET /api/backtest-history/trigger/status
# em web/server.py — NUNCA reaproveita CSS_PORTFOLIO_API_KEY (que abre
# posição real). Sem os dois definidos, disparo de backtest via web fica
# desabilitado (fail-closed). Sessão fica só em memória do processo — um
# restart do css-web-mfc.service invalida qualquer sessão ativa.
CSS_BACKTEST_USERNAME=
CSS_BACKTEST_PASSWORD=

# Qual motor decide trade_bias em agents/confluence_engine.py::
# evaluate_currency_confluence() — "3tf" (o que decidia antes do Port A,
# D1+H4+H1 sobre score bruto) ou "5tf" (Port A, matriz institucional com
# soberania macro MN1/W1). Ausente ou valor não reconhecido cai em "3tf"
# (só AVISA no log, nunca recusa — nenhuma das duas opções manda ordem
# sozinha nem é mais "perigosa" que a outra, diferente dos tetos de
# execução acima). Default voltou a ser 3tf em 2026-09-05 mesmo com o
# Port A já em produção: a análise de poder estatístico da consulta
# herdr-ask mfc-15 mostrou que o efeito de PnL líquido entre os dois é
# indetectável em qualquer amostra alcançável, e o 5tf paga ~27% mais
# custo de transação sem vantagem bruta comprovada — ver
# docs/plans/port-upstream-institutional-matrix.md, "item 6". Pedido do
# Breno pra poder alternar sem redeploy e testar 5tf junto de
# funcionalidades futuras do Miquéias antes de decidir se adota de vez.
CSS_CONFLUENCE_ENGINE=3tf
