//--- Display Mode Enumerations
enum ENUM_DISPLAY_MODE
{
   DISPLAY_ALL          = 0, // Todas as 8 Moedas (All 8 Currencies)
   DISPLAY_AUTO_BASE    = 1, // Auto: Apenas Moeda do Ativo (ex: EUR em EURUSD, NZD em NZDUSD)
   DISPLAY_AUTO_PAIR    = 2, // Auto: Moedas do Par (ex: EUR e USD em EURUSD)
   DISPLAY_SPECIFIC_CCY = 3  // Apenas Moeda Especifica (Selected Below)
};

enum ENUM_CURRENCY_SELECT
{
   CCY_USD = 0, // USD
   CCY_EUR = 1, // EUR
   CCY_GBP = 2, // GBP
   CCY_CHF = 3, // CHF
   CCY_JPY = 4, // JPY
   CCY_AUD = 5, // AUD
   CCY_CAD = 6, // CAD
   CCY_NZD = 7  // NZD
};

enum ENUM_CALC_METHOD
{
   CALC_LWMA_NON_REPAINTING = 0, // LWMA (Non-Repainting / Sem Repintura)
   CALC_CENTERED_TMA        = 1  // Centered TMA (Triangular Moving Average / Media Triangular)
};

//--- Input Parameters
input ENUM_DISPLAY_MODE     inp_displayMode      = DISPLAY_AUTO_BASE; // Modo de Exibicao (Linhas e Painel)
input ENUM_CURRENCY_SELECT   inp_specificCurrency = CCY_EUR;           // Moeda Especifica (quando Modo = Especifica)
input string          inp_symbolsToWeigh  = "AUDCAD,AUDCHF,AUDJPY,AUDNZD,AUDUSD,CADJPY,CHFJPY,EURAUD,EURCAD,EURJPY,EURNZD,EURUSD,GBPAUD,GBPCAD,GBPCHF,GBPJPY,GBPNZD,GBPUSD,NZDCHF,NZDJPY,NZDUSD,USDCAD,USDCHF,USDJPY,CADCHF,NZDCAD,EURCHF,EURGBP"; // Symbols to Weigh (28 Pairs)
input int             inp_maxBars         = 300;               // Max bars to calculate
input bool            inp_addSundayToMonday = true;            // Add Sunday to Monday (Merge/Skip Sunday D1)
input ENUM_CALC_METHOD inp_calcMethod     = CALC_LWMA_NON_REPAINTING; // Metodo de Calculo (LWMA vs Media Triangular)
input bool            inp_ignoreFuture    = true;              // Ignore Future (true = LWMA, false = Centered TMA)
input ENUM_TIMEFRAMES inp_timeframe       = PERIOD_CURRENT;    // Calculation Timeframe
input bool            inp_showCrossAlerts = true;              // Show cross highlight boxes
input bool            inp_showLevelCross  = true;              // Show level cross bullets
input double          inp_levelCrossValue = 0.20;              // Level threshold
input string          inp_nonPropFont     = "Lucida Console";  // Panel Font
input int             inp_panelXOffset    = 135;               // Distancia da Borda Direita (X)
input int             inp_panelYOffset    = 28;                // Distancia do Topo (Y)
input int             inp_panelRowHeight  = 16;                // Altura entre Linhas do Painel

input bool            inp_useFixedScale   = false;             // Fixar Escala Vertical Manualmente (true/false)
input double          inp_scaleMin        = -1.6;              // Escala Minima Vertical (se Fixa = true)
input double          inp_scaleMax        =  1.6;              // Escala Maxima Vertical (se Fixa = true)

input color           inp_Color_USD       = clrRed;
input color           inp_Color_EUR       = clrDeepSkyBlue;
input color           inp_Color_GBP       = clrRoyalBlue;
input color           inp_Color_CHF       = clrPaleTurquoise;
input color           inp_Color_JPY       = clrGold;
input color           inp_Color_AUD       = clrOrange;
input color           inp_Color_CAD       = clrMaroon;
input color           inp_Color_NZD       = clrTan;
input color           inp_colorWeakCross   = clrGold;
input color           inp_colorNormalCross = clrGold;
input color           inp_colorStrongCross = clrGold;
input color           inp_colorLevelHigh   = clrLimeGreen;
input color           inp_colorLevelLow    = clrCrimson;

//--- Global Variables
string g_shortName = "Currency Slope Strength";
string g_symbols[];
int    g_hMA[];
int    g_hATR[];
int    g_currencyOccurrences[8];
color  g_currencyColors[8];

//--- Indicator Buffers
double arrUSD[];
double arrEUR[];
double arrGBP[];
double arrCHF[];
double arrJPY[];
double arrAUD[];
double arrCAD[];
double arrNZD[];

//--- Currency Names
const string g_currencyNames[8] = {"USD", "EUR", "GBP", "CHF", "JPY", "AUD", "CAD", "NZD"};

struct SCurrencyData
{
   double currentVal;
   double priorVal;
   int    index;
};

//+------------------------------------------------------------------+
//| Get Currency Index                                               |
//+------------------------------------------------------------------+
int GetCurrencyIndex(string currency)
{
   for(int i = 0; i < 8; i++)
   {
      if(g_currencyNames[i] == currency) return i;
   }
   return -1;
}

//+------------------------------------------------------------------+
//| Helper: Verifica se a barra e de domingo                         |
//+------------------------------------------------------------------+
bool IsSundayBar(datetime t)
{
   MqlDateTime dt;
   TimeToStruct(t, dt);
   return (dt.day_of_week == 0);
}

//+------------------------------------------------------------------+
//| Helper: Verificacao se a moeda deve ser exibida no grafico/painel|
//+------------------------------------------------------------------+
bool IsCurrencyDisplayed(int ccyIdx)
{
   if(inp_displayMode == DISPLAY_ALL)
      return true;

   if(inp_displayMode == DISPLAY_SPECIFIC_CCY)
      return (ccyIdx == (int)inp_specificCurrency);

   string sym = _Symbol;
   string ccy = g_currencyNames[ccyIdx];

   // Procura as moedas contidas no nome do simbolo do grafico
   string foundCurrencies[2];
   int foundCount = 0;

   // Ordem de busca respeitando a posicao no nome do ativo
   for(int p = 0; p < StringLen(sym) - 2 && foundCount < 2; p++)
   {
      string sub = StringSubstr(sym, p, 3);
      for(int c = 0; c < 8; c++)
      {
         if(g_currencyNames[c] == sub)
         {
            foundCurrencies[foundCount++] = sub;
            p += 2; // pula os 3 caracteres encontrados
            break;
         }
      }
   }

   string baseCur  = (foundCount > 0) ? foundCurrencies[0] : StringSubstr(sym, 0, 3);
   string quoteCur = (foundCount > 1) ? foundCurrencies[1] : (foundCount == 1 ? "" : StringSubstr(sym, 3, 3));

   if(inp_displayMode == DISPLAY_AUTO_BASE)
   {
      string targetCur = baseCur;
      // Para pares contra USD (ex: USDJPY, USDCAD, USDCHF), exibe a moeda especifica (JPY, CAD, CHF)
      if(baseCur == "USD" && quoteCur != "")
         targetCur = quoteCur;
      else if(quoteCur == "USD" && baseCur != "")
         targetCur = baseCur;

      return (ccy == targetCur);
   }

   if(inp_displayMode == DISPLAY_AUTO_PAIR)
   {
      return (ccy == baseCur || (quoteCur != "" && ccy == quoteCur));
   }

   return false;
}

//+------------------------------------------------------------------+
//| Set Label Object Helper                                          |
//+------------------------------------------------------------------+
void SetLabelObject(int subwindow, string name, string text, int x, int y, ENUM_BASE_CORNER corner, color clr, int fontSize, string font)
{
   if(ObjectFind(0, name) < 0)
   {
      ObjectCreate(0, name, OBJ_LABEL, subwindow, 0, 0);
   }

   ObjectSetInteger(0, name, OBJPROP_CORNER, corner);
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, y);
   ObjectSetString(0, name, OBJPROP_TEXT, text);
   ObjectSetString(0, name, OBJPROP_FONT, font);
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, fontSize);
   ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
   ObjectSetInteger(0, name, OBJPROP_BACK, false);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
}

//+------------------------------------------------------------------+
//| Sort Currency Data Struct                                        |
//+------------------------------------------------------------------+
void SortCurrencyData(SCurrencyData &data[])
{
   int n = ArraySize(data);
   for(int i = 0; i < n - 1; i++)
   {
      for(int j = i + 1; j < n; j++)
      {
         if(data[j].currentVal > data[i].currentVal)
         {
            SCurrencyData temp = data[i];
            data[i] = data[j];
            data[j] = temp;
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Painel Lateral Direito com Legenda e Valores Ordenados          |
//+------------------------------------------------------------------+
void ShowCurrencyTable(int subwindow, const double &currVals[], const double &priorVals[])
{
   if(subwindow < 0) return;

   int yOffset   = inp_panelYOffset;
   int rowHeight = inp_panelRowHeight;
   int xBase     = inp_panelXOffset;

   ENUM_TIMEFRAMES tf = (inp_timeframe == PERIOD_CURRENT) ? _Period : inp_timeframe;
   string tfStr = EnumToString(tf);
   StringReplace(tfStr, "PERIOD_", "");

   // Titulo do Painel no Canto Superior Direito (Mais a direita e abaixo)
   SetLabelObject(subwindow, "CSS_pnl_hdr", "TF: " + tfStr, xBase, yOffset, CORNER_RIGHT_UPPER, clrWhite, 9, inp_nonPropFont);

   SCurrencyData data[8];
   for(int i = 0; i < 8; i++)
   {
      data[i].currentVal = currVals[i];
      data[i].priorVal   = priorVals[i];
      data[i].index      = i;
   }

   SortCurrencyData(data);

   int visibleRow = 0;

   for(int i = 0; i < 8; i++)
   {
      int idx = data[i].index;

      string sqObj    = "CSS_pnl_sq_" + (string)i;
      string nameObj  = "CSS_pnl_cur_" + (string)i;
      string valObj   = "CSS_pnl_val_" + (string)i;
      string crossObj = "CSS_pnl_cross_" + (string)i;
      string bulletObj= "CSS_pnl_bullet_" + (string)i;

      if(!IsCurrencyDisplayed(idx))
      {
         ObjectDelete(0, sqObj);
         ObjectDelete(0, nameObj);
         ObjectDelete(0, valObj);
         ObjectDelete(0, crossObj);
         ObjectDelete(0, bulletObj);
         continue;
      }

      color curColor = g_currencyColors[idx];
      int yPos = yOffset + (visibleRow + 1) * rowHeight;
      visibleRow++;

      // 1. Quadrado da Cor da Linha
      SetLabelObject(subwindow, sqObj, "■", xBase, yPos, CORNER_RIGHT_UPPER, curColor, 9, "Arial");

      // 2. Nome da Moeda
      SetLabelObject(subwindow, nameObj, g_currencyNames[idx], xBase - 32, yPos, CORNER_RIGHT_UPPER, curColor, 9, inp_nonPropFont);

      // 3. Valor Numerico Atual
      string valStr = StringFormat("%+5.2f", data[i].currentVal);
      SetLabelObject(subwindow, valObj, valStr, xBase - 90, yPos, CORNER_RIGHT_UPPER, curColor, 9, inp_nonPropFont);

      // 4. Indicador de Cruzamento (Caixa de Destaque)
      if(inp_showCrossAlerts && i < 7 &&
         NormalizeDouble(data[i].currentVal, 2) > NormalizeDouble(data[i+1].currentVal, 2) &&
         data[i].priorVal < data[i+1].priorVal)
      {
         color showColor = inp_colorStrongCross;
         if(data[i].currentVal > 0.8 || data[i+1].currentVal < -0.8)
            showColor = inp_colorWeakCross;
         else if(data[i].currentVal > 0.4 || data[i+1].currentVal < -0.4)
            showColor = inp_colorNormalCross;

         SetLabelObject(subwindow, crossObj, "█", xBase + 14, yPos, CORNER_RIGHT_UPPER, showColor, 9, "Arial");
      }
      else
      {
         ObjectDelete(0, crossObj);
      }

      // 5. Marcadores de Nivel (Bullets)
      if(inp_showLevelCross)
      {
         double cVal = data[i].currentVal;
         double pVal = data[i].priorVal;

         if((pVal > 0 && cVal < 0) || (pVal < inp_levelCrossValue && cVal > inp_levelCrossValue))
         {
            SetLabelObject(subwindow, bulletObj, "●", xBase - 105, yPos, CORNER_RIGHT_UPPER, inp_colorLevelHigh, 8, "Arial");
         }
         else if((pVal < 0 && cVal > 0) || (pVal > -inp_levelCrossValue && cVal < -inp_levelCrossValue))
         {
            SetLabelObject(subwindow, bulletObj, "●", xBase - 105, yPos, CORNER_RIGHT_UPPER, inp_colorLevelLow, 8, "Arial");
         }
         else
         {
            ObjectDelete(0, bulletObj);
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Atualiza Linhas Horizontais de Nivel (0, 0.2, 0.5, 1.0, 1.5)     |
//+------------------------------------------------------------------+
void UpdateLevelLines(int subwindow)
{
   if(subwindow < 0) return;

   // Linhas do Box Principal: +0.20 (Verde / Fim do Ciclo de Alta) e -0.20 (Vermelho / Fim do Ciclo de Baixa)
   // Eixo 0.0: Linha de Equilibrio (Pontilhada)
   // Demais niveis: Apenas pontilhadas sutis
   double levels[]         = { 0.0,      0.20,         -0.20,       0.50,         -0.50,        1.00,         -1.00,        1.50,         -1.50        };
   color  colors[]         = { clrGray,  clrLimeGreen, clrCrimson,  clrDimGray,   clrDimGray,   clrDimGray,   clrDimGray,   clrDimGray,   clrDimGray   };
   ENUM_LINE_STYLE styles[]= { STYLE_DOT,STYLE_SOLID,  STYLE_SOLID, STYLE_DOT,    STYLE_DOT,    STYLE_DOT,    STYLE_DOT,    STYLE_DOT,    STYLE_DOT    };
   int    widths[]         = { 1,        2,            2,           1,            1,            1,            1,            1,            1            };

   for(int i = 0; i < ArraySize(levels); i++)
   {
      string lName = "CSS_Lvl_" + (string)i;
      if(ObjectFind(0, lName) < 0)
      {
         ObjectCreate(0, lName, OBJ_HLINE, subwindow, 0, levels[i]);
         ObjectSetInteger(0, lName, OBJPROP_COLOR, colors[i]);
         ObjectSetInteger(0, lName, OBJPROP_STYLE, styles[i]);
         ObjectSetInteger(0, lName, OBJPROP_WIDTH, widths[i]);
         ObjectSetInteger(0, lName, OBJPROP_BACK, true);
         ObjectSetInteger(0, lName, OBJPROP_SELECTABLE, false);
         ObjectSetInteger(0, lName, OBJPROP_HIDDEN, true);
      }
      else
      {
         ObjectMove(0, lName, 0, 0, levels[i]);
         ObjectSetInteger(0, lName, OBJPROP_COLOR, colors[i]);
         ObjectSetInteger(0, lName, OBJPROP_STYLE, styles[i]);
         ObjectSetInteger(0, lName, OBJPROP_WIDTH, widths[i]);
      }
   }
}

//+------------------------------------------------------------------+
//| Custom indicator initialization function                         |
//+------------------------------------------------------------------+
int OnInit()
{
   SetIndexBuffer(0, arrUSD, INDICATOR_DATA);
   SetIndexBuffer(1, arrEUR, INDICATOR_DATA);
   SetIndexBuffer(2, arrGBP, INDICATOR_DATA);
   SetIndexBuffer(3, arrCHF, INDICATOR_DATA);
   SetIndexBuffer(4, arrJPY, INDICATOR_DATA);
   SetIndexBuffer(5, arrAUD, INDICATOR_DATA);
   SetIndexBuffer(6, arrCAD, INDICATOR_DATA);
   SetIndexBuffer(7, arrNZD, INDICATOR_DATA);

   ArraySetAsSeries(arrUSD, true);
   ArraySetAsSeries(arrEUR, true);
   ArraySetAsSeries(arrGBP, true);
   ArraySetAsSeries(arrCHF, true);
   ArraySetAsSeries(arrJPY, true);
   ArraySetAsSeries(arrAUD, true);
   ArraySetAsSeries(arrCAD, true);
   ArraySetAsSeries(arrNZD, true);

   for(int p = 0; p < 8; p++)
   {
      PlotIndexSetDouble(p, PLOT_EMPTY_VALUE, EMPTY_VALUE);
   }

   // Configuracao da Escala Vertical
   if(inp_useFixedScale)
   {
      IndicatorSetDouble(INDICATOR_MINIMUM, inp_scaleMin);
      IndicatorSetDouble(INDICATOR_MAXIMUM, inp_scaleMax);
   }

   g_currencyColors[0] = inp_Color_USD;
   g_currencyColors[1] = inp_Color_EUR;
   g_currencyColors[2] = inp_Color_GBP;
   g_currencyColors[3] = inp_Color_CHF;
   g_currencyColors[4] = inp_Color_JPY;
   g_currencyColors[5] = inp_Color_AUD;
   g_currencyColors[6] = inp_Color_CAD;
   g_currencyColors[7] = inp_Color_NZD;

   string rawSymbols = inp_symbolsToWeigh;
   StringTrimLeft(rawSymbols);
   StringTrimRight(rawSymbols);

   ushort u_sep = StringGetCharacter(",", 0);
   string result[];
   int count = StringSplit(rawSymbols, u_sep, result);

   ArrayResize(g_symbols, 0);
   ArrayInitialize(g_currencyOccurrences, 0);

   for(int i = 0; i < count; i++)
   {
      string sym = result[i];
      StringTrimLeft(sym);
      StringTrimRight(sym);
      if(StringLen(sym) == 0) continue;

      if(SymbolSelect(sym, true))
      {
         int sz = ArraySize(g_symbols);
         ArrayResize(g_symbols, sz + 1);
         g_symbols[sz] = sym;

         string baseCur  = StringSubstr(sym, 0, 3);
         string quoteCur = StringSubstr(sym, 3, 3);

         int bIdx = GetCurrencyIndex(baseCur);
         int qIdx = GetCurrencyIndex(quoteCur);

         if(bIdx >= 0) g_currencyOccurrences[bIdx]++;
         if(qIdx >= 0) g_currencyOccurrences[qIdx]++;
      }
   }

   int totalSymbols = ArraySize(g_symbols);
   if(totalSymbols == 0)
   {
      Print("Erro: Nenhum simbolo valido encontrado na janela Observatorio de Mercado.");
      return INIT_FAILED;
   }

   ArrayResize(g_hMA, totalSymbols);
   ArrayResize(g_hATR, totalSymbols);

   ENUM_TIMEFRAMES tf = (inp_timeframe == PERIOD_CURRENT) ? _Period : inp_timeframe;

   for(int i = 0; i < totalSymbols; i++)
   {
      g_hMA[i]  = iMA(g_symbols[i], tf, 21, 0, MODE_LWMA, PRICE_CLOSE);
      g_hATR[i] = iATR(g_symbols[i], tf, 100);

      if(g_hMA[i] == INVALID_HANDLE || g_hATR[i] == INVALID_HANDLE)
      {
         Print("Erro ao criar handles do indicador para o par: ", g_symbols[i]);
         return INIT_FAILED;
      }
   }

   IndicatorSetString(INDICATOR_SHORTNAME, g_shortName);
   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| Custom indicator deinitialization function                       |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   int total = ArraySize(g_hMA);
   for(int i = 0; i < total; i++)
   {
      if(g_hMA[i] != INVALID_HANDLE)  IndicatorRelease(g_hMA[i]);
      if(g_hATR[i] != INVALID_HANDLE) IndicatorRelease(g_hATR[i]);
   }

   ObjectsDeleteAll(0, "CSS_");
   ChartRedraw(0);
}

//+------------------------------------------------------------------+
//| Centered TMA Calculation (Media Triangular Centralizada)         |
//+------------------------------------------------------------------+
double CalcTMA(string symbol, ENUM_TIMEFRAMES tf, int shift)
{
   double c0[1];
   if(CopyClose(symbol, tf, shift, 1, c0) <= 0) return 0.0;

   double dblSum  = c0[0] * 21.0;
   double dblSumw = 21.0;

   int pastSteps = 0;
   int curShift = shift;

   while(pastSteps < 20)
   {
      curShift++;
      datetime tPast[1];
      if(CopyTime(symbol, tf, curShift, 1, tPast) <= 0) break;
      if(inp_addSundayToMonday && tf == PERIOD_D1 && IsSundayBar(tPast[0]))
         continue; // pula barra de domingo no D1

      double cPast[1];
      if(CopyClose(symbol, tf, curShift, 1, cPast) <= 0) break;

      pastSteps++;
      double knx = 21.0 - (double)pastSteps;
      dblSum  += cPast[0] * knx;
      dblSumw += knx;
   }

   int futureSteps = 0;
   curShift = shift;
   while(futureSteps < 20 && curShift > 0)
   {
      curShift--;
      datetime tFut[1];
      if(CopyTime(symbol, tf, curShift, 1, tFut) <= 0) break;
      if(inp_addSundayToMonday && tf == PERIOD_D1 && IsSundayBar(tFut[0]))
         continue; // pula barra de domingo no D1

      double cFuture[1];
      if(CopyClose(symbol, tf, curShift, 1, cFuture) <= 0) break;

      futureSteps++;
      double knx = 21.0 - (double)futureSteps;
      dblSum  += cFuture[0] * knx;
      dblSumw += knx;
   }

   return (dblSumw > 0) ? (dblSum / dblSumw) : 0.0;
}

//+------------------------------------------------------------------+
//| Get Slope for Symbol                                             |
//+------------------------------------------------------------------+
double GetSlopeForSymbol(int symbolIdx, ENUM_TIMEFRAMES tf, datetime barTime)
{
   string sym = g_symbols[symbolIdx];
   int shift = iBarShift(sym, tf, barTime, false);
   if(shift < 0) return 0.0;

   // Se for domingo no D1 com addSundayToMonday = true, ajusta o shift para segunda
   if(inp_addSundayToMonday && tf == PERIOD_D1)
   {
      datetime tCur[1];
      if(CopyTime(sym, tf, shift, 1, tCur) > 0 && IsSundayBar(tCur[0]))
      {
         shift++;
      }
   }

   double atrVal[1];
   if(CopyBuffer(g_hATR[symbolIdx], 0, shift + 10, 1, atrVal) <= 0 || atrVal[0] == 0)
      return 0.0;

   double atr = atrVal[0] / 10.0;
   if(atr == 0) return 0.0;

   double dblTma = 0.0;
   double dblPrev = 0.0;

   bool useLWMA = (inp_calcMethod == CALC_LWMA_NON_REPAINTING);
   if(!inp_ignoreFuture) useLWMA = false; // Se ignoreFuture for false, forca Centered TMA

   if(useLWMA)
   {
      double ma0[1], ma1[1], close0[1];
      if(CopyBuffer(g_hMA[symbolIdx], 0, shift, 1, ma0) <= 0) return 0.0;
      if(CopyBuffer(g_hMA[symbolIdx], 0, shift + 1, 1, ma1) <= 0) return 0.0;
      if(CopyClose(sym, tf, shift, 1, close0) <= 0) return 0.0;

      dblTma = ma0[0];
      dblPrev = (ma1[0] * 231.0 + close0[0] * 20.0) / 251.0;
   }
   else
   {
      dblTma  = CalcTMA(sym, tf, shift);
      dblPrev = CalcTMA(sym, tf, shift + 1);
   }

   return (dblTma - dblPrev) / atr;
}

//+------------------------------------------------------------------+
//| Custom indicator iteration function                              |
//+------------------------------------------------------------------+
int OnCalculate(const int rates_total,
                const int prev_calculated,
                const datetime &time[],
                const double &open[],
                const double &high[],
                const double &low[],
                const double &close[],
                const long &tick_volume[],
                const long &volume[],
                const int &spread[])
{
   if(rates_total < 30) return 0;

   ArraySetAsSeries(time, true);

   ENUM_TIMEFRAMES tf = (inp_timeframe == PERIOD_CURRENT) ? _Period : inp_timeframe;

   int limit = rates_total - prev_calculated;
   if(prev_calculated == 0)
   {
      limit = rates_total - 1;
      if(inp_maxBars > 0 && limit >= inp_maxBars)
         limit = inp_maxBars - 1;
   }
   else
   {
      limit += 1;
   }

   int totalSymbols = ArraySize(g_symbols);

   for(int i = limit; i >= 0; i--)
   {
      double currencyValues[8];
      ArrayInitialize(currencyValues, 0.0);

      for(int s = 0; s < totalSymbols; s++)
      {
         double slope = GetSlopeForSymbol(s, tf, time[i]);

         string baseCur  = StringSubstr(g_symbols[s], 0, 3);
         string quoteCur = StringSubstr(g_symbols[s], 3, 3);

         int bIdx = GetCurrencyIndex(baseCur);
         int qIdx = GetCurrencyIndex(quoteCur);

         if(bIdx >= 0) currencyValues[bIdx] += slope;
         if(qIdx >= 0) currencyValues[qIdx] -= slope;
      }

      for(int c = 0; c < 8; c++)
      {
         if(g_currencyOccurrences[c] > 0)
            currencyValues[c] /= g_currencyOccurrences[c];
         else
            currencyValues[c] = 0.0;
      }

      arrUSD[i] = IsCurrencyDisplayed(0) ? currencyValues[0] : EMPTY_VALUE;
      arrEUR[i] = IsCurrencyDisplayed(1) ? currencyValues[1] : EMPTY_VALUE;
      arrGBP[i] = IsCurrencyDisplayed(2) ? currencyValues[2] : EMPTY_VALUE;
      arrCHF[i] = IsCurrencyDisplayed(3) ? currencyValues[3] : EMPTY_VALUE;
      arrJPY[i] = IsCurrencyDisplayed(4) ? currencyValues[4] : EMPTY_VALUE;
      arrAUD[i] = IsCurrencyDisplayed(5) ? currencyValues[5] : EMPTY_VALUE;
      arrCAD[i] = IsCurrencyDisplayed(6) ? currencyValues[6] : EMPTY_VALUE;
      arrNZD[i] = IsCurrencyDisplayed(7) ? currencyValues[7] : EMPTY_VALUE;
   }

   int subwindow = ChartWindowFind(0, g_shortName);
   if(subwindow < 0)
   {
      for(int w = 1; w < (int)ChartGetInteger(0, CHART_WINDOWS_TOTAL); w++)
      {
         subwindow = w;
         break;
      }
   }

   double currentVals[8];
   double priorVals[8];

   currentVals[0] = arrUSD[0]; currentVals[1] = arrEUR[0]; currentVals[2] = arrGBP[0]; currentVals[3] = arrCHF[0];
   currentVals[4] = arrJPY[0]; currentVals[5] = arrAUD[0]; currentVals[6] = arrCAD[0]; currentVals[7] = arrNZD[0];

   priorVals[0]   = arrUSD[1]; priorVals[1]   = arrEUR[1]; priorVals[2]   = arrGBP[1]; priorVals[3]   = arrCHF[1];
   priorVals[4]   = arrJPY[1]; priorVals[5]   = arrAUD[1]; priorVals[6]   = arrCAD[1]; priorVals[7]   = arrNZD[1];

   ShowCurrencyTable(subwindow, currentVals, priorVals);
   UpdateLevelLines(subwindow);

   ChartRedraw(0);
   return rates_total;
}