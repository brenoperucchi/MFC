[Unit]
Description=CSS MFC - Dashboard web (FastAPI, porta 8050)
After=network-online.target css-mt5-mfc.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Devs/miqueias/MFC
ExecStart=%h/Devs/miqueias/MFC/scripts/systemd/web-server-wsl.sh
Restart=on-failure
RestartSec=15
Environment=CSS_PYTHON=/mnt/c/WINDOWS/py.exe
Environment=CSS_PYTHON_VERSION_FLAG=-3.12
# Default é 127.0.0.1 (só a própria máquina). Pra ver de outro dispositivo na
# rede, mude pra 0.0.0.0 aqui — decisão deliberada, não vem ligada por padrão.
Environment=CSS_WEB_HOST=127.0.0.1
Environment=CSS_WEB_PORT=8050

[Install]
WantedBy=default.target
