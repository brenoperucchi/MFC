{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/css/all",
        "destination": "/api/css/all.json"
      },
      {
        "source": "/api/track-record/live",
        "destination": "/api/track-record/live.json"
      },
      {
        "source": "/api/track-record/summary",
        "destination": "/api/track-record/summary.json"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
